# LF Carpinter - Variables de Entorno
# Copia este archivo como .env y configura tus valores

# Django
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL
DB_NAME=lf_carpinter
DB_USER=lf_user
DB_PASSWORD=lf_carpinter_2025
DB_HOST=localhost
DB_PORT=5432

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=LF Carpinter <noreply@lfcarpinter.com>

# Para desarrollo local, puedes usar console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000